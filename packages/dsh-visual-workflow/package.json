{
  "name": "dsh-visual-workflow",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 可视化工作流插件（动态双半包）：host（DSL 校验/编译/RPC/wf_run）+ client（Gold-Band 对齐的可视化编辑器：拖拽连线画布 + 配置面板 + 校验弹窗 + 模板库大抽屉 + 运行看板）",
  "type": "module",
  "main": "./dist/host-entry.mjs",
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "test": "node --test tests/host.test.mjs tests/client.smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "exports": {
    ".": "./dist/host-entry.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "dist/",
    "src/"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
