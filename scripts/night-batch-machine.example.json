{
  "_说明": "机器本地配置示例（复制到 <项目>/.scratch/night-batches/machine.json 后按本机实际调整；此文件不入库）。args 占位符：{taskId} {runId} {runDir} {worktree} {promptFile} {project}。下面 CLI 参数为示意写法，请按本机所装 AI CLI 的真实无人值守参数调整，核心要求：非交互、在指定工作树内施工、权限档与所选档位一致。",
  "agent": {
    "templates": {
      "full-access": {
        "command": "bash",
        "args": ["-lc", "claude -p \"$(cat {promptFile})\" --dangerously-skip-permissions"]
      },
      "auto-edit": {
        "command": "bash",
        "args": ["-lc", "claude -p \"$(cat {promptFile})\" --permission-mode acceptEdits"]
      }
    }
  },
  "sceneInit": {
    "command": "node",
    "args": ["{project}/scripts/cwf-run-init.mjs", "{taskId}", "{runId}", "--local-base"]
  },
  "remoteIssueCommand": "cnb issue list --repo chris.ai/workflow-manager"
}
