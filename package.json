{
  "name": "workflow-manager",
  "private": true,
  "description": "开发工作流 2.0 · DSH / vwf 统一引擎与模板同步（单一事实源：templates/ 蓝图 → 生成器 → 双入口）",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "scripts": {
    "dev:plugin": "node scripts/dev-plugin.mjs",
    "generate": "node scripts/generate.mjs",
    "install:builtin-skills": "node scripts/install-builtin-skills.mjs",
    "install:builtin-skills:pool": "node scripts/install-builtin-skills.mjs --pool",
    "audit:builtin-skills": "node scripts/installed-skill-audit.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "validate": "node scripts/validate.mjs && node scripts/validate-workspace.mjs",
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "prototype:ui": "node packages/dsh-visual-workflow/prototypes/ui-workbench/serve.mjs",
    "test": "node --test --test-concurrency=2 \"scripts/test/*.test.mjs\"",
    "test:conformance": "node --test scripts/test/workflow-conformance.test.mjs",
    "conformance": "node scripts/workflow-conformance/run.mjs",
    "benchmark:loc-045:freeze": "node scripts/benchmark/loc-045/bin/loc-045-freeze.mjs",
    "benchmark:loc-045:prepare": "node scripts/benchmark/loc-045/bin/loc-045-prepare.mjs",
    "benchmark:loc-045:plan": "node scripts/benchmark/loc-045/bin/loc-045-plan.mjs",
    "benchmark:loc-045:verify-fixtures": "node scripts/benchmark/loc-045/bin/loc-045-verify-fixtures.mjs",
    "benchmark:loc-045:report": "node scripts/benchmark/loc-045/bin/loc-045-report.mjs"
  }
}
